rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Room codes are unguessable enough for casual private games, not a
    // substitute for strong access control. Every Firebase user is anonymous.
    match /rooms/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && code.size() == 8
        && request.resource.data.keys().hasOnly(['createdBy', 'seed', 'startedAt', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.seed is int
        && request.resource.data.startedAt is int
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;

      match /players/{uid} {
        // Players who know the room code can view the room scoreboard.
        allow get, list: if request.auth != null && exists(/databases/$(database)/documents/rooms/$(code));
        // Each signed-in anonymous user can modify only their own game data.
        allow create, update: if request.auth != null
          && uid == request.auth.uid
          && exists(/databases/$(database)/documents/rooms/$(code))
          && request.resource.data.keys().hasOnly(['uid', 'name', 'worth', 'cash', 'updatedAt', 'saved'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 20
          && request.resource.data.worth is number
          && request.resource.data.cash is number
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.saved is map;
        allow delete: if request.auth != null && uid == request.auth.uid;
      }
    }
  }
}
